# ─────────────────────────────────────────────
#  Tiger Host — Environment Variables
#  NEVER commit this file to GitHub
# ─────────────────────────────────────────────

# Firebase Admin SDK (download from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=areex-cloud
FIREBASE_DATABASE_URL=https://areex-cloud-default-rtdb.asia-southeast1.firebasedatabase.app

# Path to your Firebase service account JSON file
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Admin panel password (change this!)
ADMIN_PASSWORD=Admin@2026

# Server port
PORT=3000

# Session secret (change this to a long random string)
SESSION_SECRET=change_this_to_a_long_random_secret_string_123456
